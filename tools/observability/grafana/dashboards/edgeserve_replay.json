    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "edgeserve_run_info{run=~\"$run\"}",
     "legendFormat": "",
     "refId": "A",
     "range": false,
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     },
     "displayName": "${__field.labels.policy} \u00b7 K=${__field.labels.k} \u00b7 ${__field.labels.workload}"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
