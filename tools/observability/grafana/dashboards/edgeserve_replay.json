  {
   "type": "timeseries",
   "title": "KV pool occupancy (tokens)",
   "description": "KV tokens held in the pool, by what their owner is doing: active (prefill/decode or about to send), tool_wait (agent waiting on a tool), stale (task finished, KV not yet reused), shared_prefix (forked system prompt). Dashed line: pool size (-c). Above it = overflow.",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 7,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "edgeserve_pool_kv_tokens{run=~\"$run\"}",
     "legendFormat": "{{state}}",
     "refId": "A",
     "range": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "edgeserve_pool_budget_tokens{run=~\"$run\"}",
     "legendFormat": "budget",
     "refId": "B",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 60,
      "showPoints": "never",
      "lineInterpolation": "stepAfter",
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "budget"
      },
      "properties": [
       {
        "id": "custom.stacking",
        "value": {
         "mode": "none"
        }
       },
       {
        "id": "custom.fillOpacity",
        "value": 0
       },
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          10,
          10
         ]
        }
       },
       {
        "id": "custom.lineWidth",
        "value": 2
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#f2495c"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "active"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#73bf69"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "tool_wait"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#b877d9"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "stale"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#8f6b4a"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "shared_prefix"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#ffcb7d"
        }
       }
      ]
     }
    ]
   },
