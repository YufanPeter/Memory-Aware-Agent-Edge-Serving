{
 "uid": "edgeserve-replay",
 "title": "EdgeServe replay",
 "tags": [
  "edgeserve"
 ],
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "timezone": "utc",
 "time": {
  "from": "2026-01-01T00:00:00.000Z",
  "to": "2026-01-01T00:08:00.000Z"
 },
 "refresh": "",
 "timepicker": {
  "refresh_intervals": [
   "1s",
   "2s",
   "5s",
   "10s",
   "30s"
  ]
 },
 "templating": {
  "list": [
   {
    "name": "run",
    "label": "run",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prom"
    },
    "query": {
     "query": "label_values(edgeserve_run_info, run)",
     "refId": "run"
    },
    "definition": "label_values(edgeserve_run_info, run)",
    "refresh": 2,
    "multi": true,
    "includeAll": true,
    "sort": 1,
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    }
   }
  ]
 },
 "annotations": {
  "list": []
 },
 "description": "Replayed runs (exporter.py replay). Time axis = time since the run started, shown from 00:00 (2026-01-01 UTC anchor). Pick runs with the $run variable.",
 "panels": [
  {
   "type": "row",
   "title": "$run",
   "repeat": "run",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": [],
   "id": 1
  },
  {
   "type": "stat",
   "title": "Run",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 3
   },
