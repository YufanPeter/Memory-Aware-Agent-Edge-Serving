+// edgeserve patch: POST /slots/{id}?action=fork  {"src": <slot>, "n_tokens": <n>}
+// Makes slot `id` share the first n tokens of slot `src` (KV cells and cached-token list) without
+// copying or recomputing them. Only meaningful with --kv-unified, where all slots share one stream.
+std::unique_ptr<server_res_generator> server_routes::handle_slots_fork(const server_http_req & req, int id_slot) {
+    auto res = create_response();
+    int id_src   = -1;
+    int n_tokens = -1;
+    try {
+        const json request_data = json::parse(req.body);
+        id_src   = request_data.at("src").get<int>();
+        n_tokens = request_data.value("n_tokens", -1);
+    } catch (const std::exception &) {
+        res->error(format_error_response("fork needs {\"src\": <slot>, \"n_tokens\": <n>}", ERROR_TYPE_INVALID_REQUEST));
+        return res;
+    }
+
+    auto & rd = res->rd;
+    {
+        server_task task(SERVER_TASK_TYPE_SLOT_FORK);
+        task.id = rd.get_new_id();
+        task.slot_action.id_slot  = id_slot;
+        task.slot_action.id_src   = id_src;
+        task.slot_action.n_tokens = n_tokens;
+        rd.post_task(std::move(task));
+    }
+
+    auto result = rd.next(req.should_stop);
+    if (!result) {
+        // connection was closed
+        GGML_ASSERT(req.should_stop());
+        return res;
+    }
+
+    if (result->is_error()) {
+        res->error(result->to_json());
+        return res;
+    }
+
+    GGML_ASSERT(dynamic_cast<server_task_result_slot_fork*>(result.get()) != nullptr);
+    res->ok(result->to_json());
+    return res;
+}
